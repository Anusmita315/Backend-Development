<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Timetable</title>
</head>
<body>

    <h1>Course Timetable</h1>

    <table border="1">
        <tr>
            <th>Day</th>
            <th>Time</th>
            <th>Subject</th>
            <th>Faculty</th>
        </tr>

        <% timetable.forEach(item => { %>
            <tr>
                <td><%= item.day %></td>
                <td><%= item.time %></td>
                <td><%= item.subject %></td>
                <td><%= item.faculty %></td>
            </tr>
        <% }); %>

    </table>

</body>
</html>